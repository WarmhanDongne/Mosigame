rules_version = '2';

// 방과 게임 상태는 Realtime Database(`database.rules.json`)에만 있습니다.
// Firestore에는 게임 스토어 목록, 사용자 프로필, 온보딩 상태만 남습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 게임 스토어 목록입니다. 등록과 수정은 콘솔에서만 합니다.
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 상점의 게임 묶음 진열 카탈로그입니다. 구성과 공개 여부는 관리자가
    // 등록하고 앱은 인증된 사용자에게 읽기만 허용합니다.
    match /gameBundles/{bundleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 앱 시작 시 확인하는 공개 설정입니다(스토어 업데이트가 필요한 최소 빌드
    // 번호 등). 로그인 전 화면에서도 읽어야 하므로 누구나 읽을 수 있고, 수정은
    // 콘솔에서만 합니다. 개인정보나 비밀 값을 넣지 않습니다.
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // 사용자 프로필과 보유 게임(`ownedGames`)입니다. 민감 필드가 같은 문서에
    // 있으므로 본인만 읽습니다. 그룹 보유 게임은 인증된 callable이 방 참가자를
    // 검증한 뒤 필요한 ID만 반환합니다.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // 인증·프로필 설정 단계는 본인만 읽고 Cloud Functions만 씁니다.
    match /userOnboarding/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
  }
}
